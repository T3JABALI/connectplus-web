# ---------- Core ----------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/connectplus
# Set to true only when connecting to Render's EXTERNAL database URL. Not needed for the internal URL.
DATABASE_SSL=false
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me-1234
# Required in production (24+ chars). Protects /admin routes.
ADMIN_API_KEY=
# Comma-separated frontend origins allowed to call this API. No trailing slash.
CORS_ORIGINS=http://localhost:5173
# Public https URL of this API (needed for M-Pesa callbacks)
PUBLIC_URL=

# ---------- Commission rules ----------
SELF_COMMISSION_RATE=0.02
REF_COMMISSION_RATE=0.05
MIN_WITHDRAWAL_KES=100
# Hours before a new commission can be withdrawn. Use 0 while testing.
COMMISSION_HOLD_HOURS=0

# ---------- Login codes (SMS) ----------
# console = print codes in the server log (development only)
# africastalking = send real SMS
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false
# Development only: every login code becomes this value. Never set in production.
DEV_FIXED_OTP=123456

# ---------- M-Pesa (Safaricom Daraja) ----------
# mock = simulate payments (development only), sandbox = Daraja sandbox, production = live
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline for Paybill, CustomerBuyGoodsOnline for Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number if using a Till; defaults to the shortcode
MPESA_PARTY_B=
# Long random string. It becomes part of the callback URL.
MPESA_CALLBACK_SECRET=
# Confirm every success callback with Safaricom before trusting it
MPESA_VERIFY_CALLBACKS=true

# ---------- Bundle delivery ----------
# mock = pretend to deliver (development only), http = your provider (see src/services/delivery.js)
DELIVERY_PROVIDER=mock
DELIVERY_API_URL=
DELIVERY_API_KEY=

# ---------- Process options ----------
AUTO_MIGRATE=true
RUN_WORKER=true
